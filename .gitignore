# ============================================================
# Root .gitignore for AI Resume Analyzer
# ============================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Databases
*.db
*.sqlite
*.sqlite3

# Environment Variables & Secrets
.env
.env.local
.env.*.local
!.env.example

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Temporary & user uploads
*.log
scratch/
